# Per-account env — copy to accounts/<account>.env and fill in.
REACH_ACCOUNT=acct001
REACH_BROWSER_PROXY=http://user:pass@proxy.example:7000
# Fingerprint template from the shardx library (stable per account).
REACH_BROWSER_PROFILE=linux-desktop-chrome
# 1 = boot fails when `agent-reach check` fails; 0 while onboarding/logging in.
FARM_BOOT_CHECK=1
# 1 = netns hard kill-switch at boot: only TCP egress to the resolved proxy
# IP:port, DNS/DoT dead, OUTPUT policy DROP (contract §2 layer-2). Requires the
# compose `user: root` + `cap_add: NET_ADMIN` wiring — 0 is a dev escape hatch.
FARM_KILLSWITCH=1
# Optional: record the source pin into the image at build time.
# AGENT_REACH_SOURCE_SHA=<git sha>
